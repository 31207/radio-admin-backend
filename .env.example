# 点歌管理台后端配置文件：复制为 .env 后修改（已导出的同名环境变量优先）

# 数据库连接串（必填，PostgreSQL，与 bot 共用同一个库）
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/qqbot

# 登录账号 + 密码；密码留空则不鉴权（仅本地调试）
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# 监听端口 / 允许的跨域来源（逗号分隔，默认全部）
WEB_ADMIN_PORT=8600
WEB_ADMIN_CORS=*

# 筛选 agent 所用大模型（OpenAI 兼容接口；不配则 agent 判定返回「未知」）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
